{
  // One ESM .js and one .d.ts per source file, readable in node_modules.
  // No Node.js types here: the package runs in Node.js, Bun, Deno and workerd.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "isolatedDeclarations": true,
    "sourceMap": false,
    "newLine": "lf",
    "allowJs": false,
    "types": []
  },
  "include": ["src"]
}
