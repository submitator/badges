---
// A wall whose directory link has & and quotes in its href and title. Astro 4
// and 5 write such a URL unescaped when it is a plain string; the package's
// Node.astro must keep both attributes whole.
import { SubmitatorBadges } from "@submitator/badges/astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hostile link</title>
  </head>
  <body>
    <main>
      <h1>Hostile link</h1>
    </main>
    <footer>
      <SubmitatorBadges
        project="00000000-0000-4000-8000-000000000007"
        apiUrl="http://127.0.0.1:4010"
        publicKeys={{ "test-rfc8032-1": "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo" }}
      />
    </footer>
  </body>
</html>
